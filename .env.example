DEMO_MODE=true
# Set AUTH_REQUIRED=true for any deployed/public environment.
AUTH_REQUIRED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MAX_REFUND_AMOUNT=2000
DAILY_REFUND_CAP=10000
DATABASE_PATH=merchantos.db
EVIDENCE_UPLOAD_DIR=evidence_uploads
# PostgreSQL identity and workspace directory (domain tables remain on legacy SQLite in this release)
DATABASE_URL=postgresql+psycopg://merchantos:change-me@postgres:5432/merchantos
IDENTITY_DATABASE_URL=
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ACCESS_TOKEN_MINUTES=60
VITE_API_BASE=http://localhost:8000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MERCHANTOS_CREDENTIALS_KEY=
PAYPAL_WEBHOOK_ID=
PAYPAL_EXECUTION_ENABLED=false
PUBLIC_APP_URL=http://localhost:8000

# Render Workflows (optional locally; required for deployed PayPal webhook processing)
RENDER_API_KEY=
WORKFLOW_SERVICE_SLUG=merchantos-events
MERCHANTOS_WORKFLOW_SHARED_SECRET=replace-with-at-least-32-random-characters

# Phase 4: financial execution is disabled by default and Sandbox-only.
PAYPAL_EXECUTION_ENABLED=false

# Release / deployment safety gates
APP_ENV=development
SEED_DEMO_DATA=false
MERCHANTOS_SINGLE_TENANT_PILOT=false

# Security hardening: generate a one-time bootstrap token (>=32 random chars)
# and send it as X-MerchantOS-Bootstrap-Token only when creating the first OWNER.
MERCHANTOS_BOOTSTRAP_REGISTRATION_TOKEN=
JWT_ISSUER=merchantos-api
JWT_AUDIENCE=merchantos-client

# Tenant RLS: native PostgreSQL RLS migration is applied by `alembic upgrade head`.
# Keep multi-tenant mode disabled until legacy SQLite domain routes are migrated.
MULTI_TENANT_ENABLED=false

# Privacy: customer review text stays on the local processing path by default.
# Set true only after a documented processor/DPA review and data-redaction approval.
MERCHANTOS_ALLOW_EXTERNAL_REVIEW_PROCESSING=false
MERCHANTOS_EXTERNAL_REVIEW_DPA_ACK=false
MERCHANTOS_EXTERNAL_REVIEW_REDACTION_ACK=false

# Production: set EVIDENCE_UPLOAD_DIR to private persistent storage outside app/static.
# Example: /var/data/merchantos-evidence
EVIDENCE_UPLOAD_DIR=evidence_uploads
MAX_EVIDENCE_FILE_BYTES=10485760
