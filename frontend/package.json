  },
  "dependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "6.30.1",
    "recharts": "2.15.3",
    "vite": "6.3.5"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "typescript": "5.8.3"
